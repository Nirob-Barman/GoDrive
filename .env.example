# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.
# Keys use ASP.NET Core's "__" nesting convention so they bind directly into IOptions<T> sections.

# --- JWT ---
JWT__KEY=
JWT__ISSUER=GoDrive
JWT__AUDIENCE=GoDriveClients

# --- SQL Server ---
CONNECTIONSTRINGS__DEFAULTCONNECTION=

# --- Cloudinary (car images, profile images, NID/passport + driving license images) ---
CLOUDINARY__CLOUDNAME=
CLOUDINARY__APIKEY=
CLOUDINARY__APISECRET=

# --- Stripe (payment collected in full at reservation approval) ---
STRIPE__PUBLISHABLEKEY=
STRIPE__SECRETKEY=
STRIPE__WEBHOOKSECRET=

# --- Email (Gmail SMTP via MailKit) — Enabled=false is the safe default; flip to true only when SMTP creds below are set ---
EMAILSETTINGS__ENABLED=false
EMAILSETTINGS__USERNAME=
EMAILSETTINGS__PASSWORD=
