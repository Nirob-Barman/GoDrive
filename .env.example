# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit it.
# Keys use ASP.NET Core's "__" nesting convention so they bind directly into IOptions<T> sections.

# --- JWT ---
JWT__KEY=
JWT__ISSUER=GoDrive
JWT__AUDIENCE=GoDriveClients

# --- SQL Server ---
# e.g. Server=WINDOWS\SQLEXPRESS;Database=GoDriveDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
CONNECTIONSTRINGS__DEFAULTCONNECTION=

# --- Cloudinary (car images, profile images, NID/passport + driving license images) ---
CLOUDINARY__CLOUDNAME=
CLOUDINARY__APIKEY=
CLOUDINARY__APISECRET=

# --- Stripe (payment collected in full at reservation approval) ---
STRIPE__PUBLISHABLEKEY=
STRIPE__SECRETKEY=
STRIPE__WEBHOOKSECRET=
# Where Stripe Checkout redirects back to - the frontend's own return pages, not the API.
STRIPE__SUCCESSURL=http://localhost:5173/payment/return
STRIPE__CANCELURL=http://localhost:5173/payment/cancelled

# --- Email (Gmail SMTP via MailKit) — Enabled=false is the safe default; flip to true only when SMTP creds below are set ---
EMAILSETTINGS__ENABLED=false
EMAILSETTINGS__USERNAME=
EMAILSETTINGS__PASSWORD=

# --- Development admin account seeded at startup (Admin role) ---
SEEDADMIN__EMAIL=
SEEDADMIN__PASSWORD=
SEEDADMIN__FULLNAME=

# --- CORS (the React client's origin - not a secret, but appsettings.json is fully
# git-ignored in this repo with no committed template, so .env is the only reproducible place) ---
CORS__ALLOWEDORIGIN=http://localhost:5173
